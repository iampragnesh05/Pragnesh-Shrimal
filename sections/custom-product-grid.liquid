    JAVASCRIPT — Sourced from external file
    ============================================================ {%- endcomment -%}
<script src="{{ 'product-grid-popup.js' | asset_url }}"></script>

{%- comment -%}
  Separate script for hotspot drag positioning.
  This handles the localStorage persistence and drag-to-reposition UX.
{%- endcomment -%}
<script>
(function () {
  'use strict';

  const DRAG_THRESHOLD = 5; // px of movement before it's considered a drag

  /**
   * Restore saved drag positions from localStorage for all hotspots.
   * Key format: pg-dot-position-{blockId}
   * Value: JSON { x: number, y: number } (percentages 0–100)
   */
  function restoreSavedPositions() {
    document.querySelectorAll('.pg__dot[data-block-id]').forEach(function (dot) {
      var key = 'pg-dot-position-' + dot.dataset.blockId;
      var saved = null;

      try {
        saved = JSON.parse(localStorage.getItem(key));
      } catch (e) {
        // Silently ignore parse errors
      }

      if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') {
        applyPosition(dot, saved.x, saved.y);
      }

      // Add drag hint tooltip
      dot.setAttribute('data-drag-hint', 'drag to reposition');
    });
  }

  /**
   * Apply a percentage position to a hotspot (centers via CSS transform).
   * Clamps values to keep dot fully inside the image (5–95%).
   */
  function applyPosition(dot, xPct, yPct) {
    xPct = Math.min(95, Math.max(5, xPct));
    yPct = Math.min(95, Math.max(5, yPct));
    dot.style.left = xPct + '%';
    dot.style.top = yPct + '%';
    dot.style.right = 'auto';
    dot.style.bottom = 'auto';
    dot.dataset.x = xPct;
    dot.dataset.y = yPct;
  }

  /**
   * Save a hotspot position to localStorage.
   */
  function savePosition(dot, xPct, yPct) {
    var key = 'pg-dot-position-' + dot.dataset.blockId;
    try {
      localStorage.setItem(key, JSON.stringify({ x: xPct, y: yPct }));
    } catch (e) {
      // Silently fail if localStorage is unavailable
    }
  }

  /**
   * Initialize drag-to-reposition for a hotspot button.
   * Uses Pointer Events API (mouse + touch + stylus).
   * Distinguishes a drag from a click via a movement threshold.
   */
  function initDraggable(dot) {
    var dragState = null;

    dot.addEventListener('pointerdown', function (e) {
      // Only primary button (left-click / touch)
      if (e.button !== 0 && e.pointerType === 'mouse') return;

      e.preventDefault();
      dot.setPointerCapture(e.pointerId);

      var wrap = dot.closest('.pg__img-wrap');
      var rect = wrap.getBoundingClientRect();

      dragState = {
        startX: e.clientX,
        startY: e.clientY,
        moved: false,
        wrapRect: rect
      };
    });

    dot.addEventListener('pointermove', function (e) {
      if (!dragState) return;

      var dx = e.clientX - dragState.startX;
      var dy = e.clientY - dragState.startY;

      // Upgrade to drag once threshold is exceeded
      if (!dragState.moved && (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD)) {
        dragState.moved = true;
        dot.classList.add('is-dragging');
      }

      if (!dragState.moved) return;

      // Re-measure wrap rect in case page has scrolled
      var rect = dot.closest('.pg__img-wrap').getBoundingClientRect();
      var xPct = ((e.clientX - rect.left) / rect.width) * 100;
      var yPct = ((e.clientY - rect.top) / rect.height) * 100;

      applyPosition(dot, xPct, yPct);
    });

    dot.addEventListener('pointerup', function (e) {
      if (!dragState) return;

      dot.classList.remove('is-dragging');

      if (dragState.moved) {
        // Drag ended: save final position
        var rect = dot.closest('.pg__img-wrap').getBoundingClientRect();
        var xPct = ((e.clientX - rect.left) / rect.width) * 100;
        var yPct = ((e.clientY - rect.top) / rect.height) * 100;
        applyPosition(dot, xPct, yPct);
        savePosition(dot, parseFloat(dot.dataset.x), parseFloat(dot.dataset.y));
      }
      // If no movement, the click is handled by product-grid-popup.js

      dragState = null;
    });

    dot.addEventListener('pointercancel', function () {
      if (dragState) {
        dot.classList.remove('is-dragging');
        dragState = null;
      }
    });
  }

  // Initialize drag for all hotspot buttons
  restoreSavedPositions();
  document.querySelectorAll('.pg__dot:not([disabled])').forEach(function (dot) {
    initDraggable(dot);
  });

})();
</script>


{%- comment -%} ============================================================
    SCHEMA — Customizer settings
    ============================================================ {%- endcomment -%}
{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "pg-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "header",
          "content": "Hotspot Position (default)"
        },
        {
          "type": "paragraph",
          "content": "Sets the starting position of the + button. On the storefront you can also drag it anywhere on the image — the dragged position is saved automatically."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Horizontal position (X %)",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 75,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "hotspot_y",
