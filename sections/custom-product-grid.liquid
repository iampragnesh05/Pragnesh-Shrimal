{% comment %}
  ============================================================
  Section: Custom Product Grid
  Description: 3×2 photo grid. Each image has a small circular
               "+" hotspot. Clicking it opens a popup matching
               the Figma design: product image | name, price,
               description, color pills, size dropdown, ATC btn.

  Hotspot positioning:
    • Default X/Y set via range sliders in the Theme Customizer
      (stored as percent values 0–100 in block settings).
    • On the storefront the dot is DRAGGABLE — drag it anywhere
      on the image; the new position is saved to localStorage
      (keyed by block ID) and survives page refreshes.
    • In the Customizer the position always reflects the schema
      sliders so merchants can set a clean baseline.

  Special rule: variant Black + Medium → also add Soft Winter Jacket
  No jQuery — vanilla JS only.
  Author: Candidate
  ============================================================
{% endcomment %}

<section class="pg full-width-section" id="pg-section" aria-label="Product Grid">

  {% if section.settings.heading != blank %}
    <h2 class="pg__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="pg__grid">
    {% for block in section.blocks %}
      {%- assign product = block.settings.product -%}

      <div class="pg__cell" {{ block.shopify_attributes }}>

        {% if product != blank %}

          <div class="pg__img-wrap">

            {% if product.featured_image %}
              <img
                class="pg__img"
                src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
                alt="{{ product.featured_image.alt | escape | default: product.title }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="pg__img pg__img--ph">
                {{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}
              </div>
            {% endif %}

            {%- comment -%}
              Hotspot "+" button.
              All product data is embedded as data-* attributes so the
              popup JS can populate itself with zero extra XHR requests.
              data-x / data-y hold the default position (%) from the
              Customizer sliders; JS overrides them with any saved
              drag position stored in localStorage.
            {%- endcomment -%}
            {%- assign dot_x = block.settings.hotspot_x | default: 85 -%}
            {%- assign dot_y = block.settings.hotspot_y | default: 80 -%}
            <button
              class="pg__dot"
              aria-label="Quick view {{ product.title | escape }}"
              data-block-id="{{ block.id }}"
              data-x="{{ dot_x }}"
              data-y="{{ dot_y }}"
              style="left:{{ dot_x }}%;top:{{ dot_y }}%;right:auto;bottom:auto;"
              data-title="{{ product.title | escape }}"
              data-price="{{ product.selected_or_first_available_variant.price | money }}"
              data-desc="{{ product.description | strip_html | escape | truncate: 280 }}"
              data-img="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
              data-handle="{{ product.handle }}"
              data-variants="{{ product.variants | json | escape }}"
              data-options="{{ product.options_with_values | json | escape }}"
            >+</button>

          </div>

        {% else %}
          {%- comment -%} Empty slot — visible only inside the editor {%- endcomment -%}
          <div class="pg__img-wrap">
            <div class="pg__img pg__img--ph">
              {{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}
            </div>
            <button class="pg__dot" disabled aria-hidden="true">+</button>
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>

</section>


{%- comment -%} ============================================================
    POPUP MODAL — one shared instance, populated dynamically by JS
    ============================================================ {%- endcomment -%}
<div
  id="pg-popup"
  class="pgp"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pgp-title"
  aria-hidden="true"
>
  {%- comment -%} Backdrop — click to close {%- endcomment -%}
  <div class="pgp__bd" id="pgp-bd"></div>

  <div class="pgp__box">

    {%- comment -%} × close button {%- endcomment -%}
    <button class="pgp__close" id="pgp-close" aria-label="Close popup">&#x2715;</button>

    {%- comment -%} Left — product image {%- endcomment -%}
    <div class="pgp__img-col">
      <img id="pgp-img" src="" alt="" class="pgp__img">
    </div>

    {%- comment -%} Right — product details {%- endcomment -%}
    <div class="pgp__info">

      <h2 class="pgp__title" id="pgp-title"></h2>
      <p  class="pgp__price" id="pgp-price"></p>
      <p  class="pgp__desc"  id="pgp-desc"></p>

      {%- comment -%} Variant selectors rendered by JS {%- endcomment -%}
      <div id="pgp-controls" class="pgp__controls"></div>

      {%- comment -%} ADD TO CART button {%- endcomment -%}
      <button id="pgp-atc" class="pgp__atc" type="button">
        <span class="pgp__atc-label">ADD TO CART</span>
        <span class="pgp__atc-arrow" aria-hidden="true">&#x2192;</span>
      </button>

      {%- comment -%} Inline status / error message {%- endcomment -%}
      <p id="pgp-fb" class="pgp__fb" aria-live="polite"></p>

    </div>
  </div>
</div>


{%- comment -%} ============================================================
    STYLES — scoped to this section
    ============================================================ {%- endcomment -%}
<style>

/* ================================================================
   FULL-WIDTH BREAKOUT (scoped to this section only)
   ================================================================ */
.full-width-section {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  padding-left: 0;
  padding-right: 0;
  overflow-x: clip;
}

.full-width-section .page-width {
  max-width: 100% !important;
  padding: 0 !important;
}

.full-width-section .grid {
  margin: 0;
}

.full-width-section img {
  width: 100%;
  display: block;
}

.full-width-section .pg__grid {
  max-width: none;
  width: 100%;
}

/* ================================================================
   PRODUCT GRID
   ================================================================ */

.pg {
  padding: 48px 40px;
  background: #fff;
}

.pg__heading {
  font-size: 1.2rem;
  font-weight: 400;
  color: #111;
  margin: 0 0 20px 0;
  letter-spacing: 0.01em;
}

/* 3 equal columns, tight gap to match Figma screenshot */
.pg__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  max-width: 1200px;
}

/* ── Grid cell ── */
.pg__cell {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  background: #ddd;
}

/* ── Image wrapper (relative so hotspot sits inside) ── */
.pg__img-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

/* ── Product image ── */
.pg__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}
.pg__cell:hover .pg__img {
  transform: scale(1.04);
}

/* Placeholder when no image assigned */
.pg__img--ph {
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── "+" Hotspot button ──
   Positioned via left/top percentage (set by Customizer sliders
   or overridden by drag). Transform centers the dot on that point.
   A pulsing ring animation draws the eye.
──────────────────────────────────────────────────────────── */
.pg__dot {
  position: absolute;
  /* left & top set inline by Liquid / JS as percentages */
  transform: translate(-50%, -50%);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  border: 1.5px solid rgba(0, 0, 0, 0.22);
  font-size: 1.25rem;
  font-weight: 300;
  line-height: 1;
  color: #222;
  cursor: grab;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  z-index: 3;
  /* pulsing ring */
  animation: dot-pulse 2.6s ease-in-out infinite;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
  /* prevent text selection while dragging */
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;   /* needed for pointer events on touch */
}

.pg__dot:hover {
  background: #fff;
  border-color: #111;
  animation: none;
}

/* While actively dragging */
.pg__dot.is-dragging {
  cursor: grabbing;
  animation: none;
  transform: translate(-50%, -50%) scale(1.25);
  box-shadow: 0 4px 16px rgba(0,0,0,0.25);
}

/* Drag-mode tooltip shown above the dot */
.pg__dot::before {
  content: attr(data-drag-hint);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.72);
  color: #fff;
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  white-space: nowrap;
  padding: 3px 7px;
  border-radius: 3px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s;
}

.pg__dot:hover::before {
  opacity: 1;
}

@keyframes dot-pulse {
  0%   { box-shadow: 0 0 0 0   rgba(0,0,0,0.4);  }
  60%  { box-shadow: 0 0 0 10px rgba(0,0,0,0);   }
  100% { box-shadow: 0 0 0 0   rgba(0,0,0,0);    }
}


/* ================================================================
   POPUP OVERLAY
   ================================================================ */

.pgp {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease;
  padding: 12px;
}

.pgp.is-open {
  opacity: 1;
  pointer-events: all;
}

/* ── Translucent backdrop ── */
.pgp__bd {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.48);
}

/* ── Dialog card ── */
.pgp__box {
  position: relative;
  background: #fff;
  border-radius: 6px;
  width: 100%;
  max-width: 100%;
  max-height: 92vh;
  overflow-y: auto;
  display: flex;
  flex-direction: row;
  z-index: 1;
  transform: scale(0.98);
  transition: transform 0.28s ease;
  box-shadow: 0 20px 60px rgba(0,0,0,0.22);
  margin: 0 auto;
}

.pgp.is-open .pgp__box {
  transform: scale(1);
}

/* ── × close ── */
.pgp__close {
  position: absolute;
  top: 10px;
  right: 12px;
  background: none;
  border: none;
  font-size: 1.15rem;
  cursor: pointer;
  color: #444;
  padding: 4px 6px;
  line-height: 1;
  z-index: 2;
  transition: color 0.15s;
}
.pgp__close:hover { color: #000; }

/* ── Left: image column ── */
.pgp__img-col {
  flex: 0 0 42%;
  overflow: hidden;
  border-radius: 6px 0 0 6px;
  min-height: 300px;
}

.pgp__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Right: info column ── */
.pgp__info {
  flex: 1;
  padding: 30px 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.pgp__title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #111;
  margin: 0;
  padding-right: 26px;
  line-height: 1.3;
}

.pgp__price {
  font-size: 1rem;
  font-weight: 400;
  color: #111;
  margin: 0;
}

.pgp__desc {
  font-size: 0.8rem;
  line-height: 1.65;
  color: #555;
  margin: 0;
}

/* ── Variant controls ── */
.pgp__controls {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 2px;
}

/* Option group label (e.g. "Color", "Size") */
.pgp-opt__label {
  font-size: 0.78rem;
  font-weight: 600;
  color: #111;
  letter-spacing: 0.03em;
  margin-bottom: 7px;
  display: block;
}

/* ── COLOR PILLS (matching Figma's grid layout) ── */
.pgp-pills-wrapper {
  /* Wrapper creates a border around all pills */
  border: 1.5px solid #111;
  border-radius: 0;
  padding: 0;
  display: inline-block;
  width: 100%;
}

.pgp-opt__pills {
  display: grid;
  grid-template-columns: 1fr 1fr;  /* Two equal-width columns matching Figma */
  gap: 0;
  margin: 0;
}

.pgp-pill {
  padding: 10px 16px;
  border: none;
  border-right: 1.5px solid #111;   /* Divider between pills */
  background: #fff;
  border-radius: 0;
  font-size: 0.82rem;
  color: #333;
  cursor: pointer;
  transition: background 0.18s, color 0.18s;
  text-align: center;
  font-weight: 500;
}

/* Remove right border from last pills in each row to avoid double border */
.pgp-pill:nth-child(2) {
  border-right: none;
}

.pgp-pill:hover {
  background: #f5f5f5;
}

/* Selected pill — black background, white text, blue left accent */
.pgp-pill.is-sel {
  background: #111;
  color: #fff;
  border-left: 3.5px solid #2563eb;  /* Figma blue accent */
  padding-left: calc(16px - 3.5px);   /* Adjust padding to keep alignment */
}

/* ── CUSTOM SIZE DROPDOWN ── */
.pgp-size-wrap {
  position: relative;
}

.pgp-size-trigger {
  width: 100%;
  padding: 10px 38px 10px 13px;
  border: 1.5px solid #bbb;
  border-radius: 3px;
  background: #fff;
  font-size: 0.82rem;
  color: #333;
  cursor: pointer;
  transition: border-color 0.18s;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 500;
}

.pgp-size-trigger:hover {
  border-color: #555;
}

.pgp-size-trigger:focus {
  outline: none;
  border-color: #111;
}

.pgp-size-trigger__text {
  flex: 1;
  text-align: left;
}

.pgp-size-trigger__chevron {
  font-size: 0.7rem;
  color: #555;
  margin-left: 10px;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

/* Chevron rotates 180° when dropdown is open */
.pgp-size-wrap.is-open .pgp-size-trigger__chevron {
  transform: rotate(180deg);
}

/* Hidden list of size options */
.pgp-size-list {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border: 1.5px solid #bbb;
  border-top: none;
  border-radius: 0 0 3px 3px;
  display: none;
  flex-direction: column;
  z-index: 10;
  max-height: 200px;
  overflow-y: auto;
}

.pgp-size-wrap.is-open .pgp-size-list {
  display: flex;
}

.pgp-size-item {
  padding: 10px 13px;
  background: #fff;
  border: none;
  border-bottom: 1px solid #eee;
  font-size: 0.82rem;
  color: #333;
  cursor: pointer;
  text-align: center;
  font-weight: 500;
  transition: background 0.15s, color 0.15s;
}

.pgp-size-item:last-child {
  border-bottom: none;
}

.pgp-size-item:hover {
  background: #111;
  color: #fff;
}

.pgp-size-item:active {
  background: #111;
  color: #fff;
}

/* ── ADD TO CART button ── */
.pgp__atc {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 4px;
  padding: 14px 18px;
  background: #111;
  color: #fff;
  border: none;
  border-radius: 3px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, transform 0.18s;
}
.pgp__atc:hover { background: #333; transform: translateY(-2px); }
.pgp__atc:active { transform: translateY(0); }
.pgp__atc:disabled { background: #999; cursor: not-allowed; transform: none; }

.pgp__atc-arrow {
  font-size: 1rem;
  transition: transform 0.2s;
}
.pgp__atc:hover .pgp__atc-arrow { transform: translateX(5px); }

/* ── Status message ── */
.pgp__fb {
  font-size: 0.76rem;
  min-height: 1em;
  margin: 0;
  color: #2a7a2a;
  font-weight: 600;
}
.pgp__fb.is-err { color: #c0392b; }


/* ================================================================
   RESPONSIVE — tablet ≤ 900px
   ================================================================ */
@media (max-width: 900px) {
  .pg__grid { grid-template-columns: repeat(2, 1fr); }
}

/* ================================================================
   RESPONSIVE — mobile ≤ 600px
   ================================================================ */
@media (max-width: 600px) {
  .pg         { padding: 28px 14px; }
  .pg__grid   { grid-template-columns: repeat(2, 1fr); gap: 3px; }

  /* Mobile popup: centered and full width */
  .pgp {
    padding: 12px;
  }

  .pgp__box {
    width: 100%;
    max-width: none;
    border-radius: 8px;
    max-height: 85vh;
    flex-direction: column;
    transform: scale(0.95);
  }

  .pgp.is-open .pgp__box {
    transform: scale(1);
  }

  .pgp__img-col {
    flex: none;
    height: 220px;
    min-height: unset;
    border-radius: 8px 8px 0 0;
  }

  .pgp__info { padding: 20px 16px 18px; }

  /* Adjust close button on mobile */
  .pgp__close {
    top: 8px;
    right: 8px;
  }
}

</style>


