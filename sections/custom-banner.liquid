{% comment %} Custom Banner Section {% endcomment %}

<style>
  .custom-banner {
    position: relative;
    width: 100%;
    font-family: sans-serif;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  /* ── TOP NAV BAR ── */
  .custom-banner__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    border-bottom: 1px solid #e0e0e0;
    position: relative;
    z-index: 10;
    background: {{ section.settings.background_color }};
  }

  .custom-banner__logo {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
  }

  .custom-banner__announcement {
    font-size: 14px;
    color: {{ section.settings.announcement_color }};
    letter-spacing: 0.5px;
  }

  .custom-banner__topbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: {{ section.settings.topbar_btn_bg }};
    color: {{ section.settings.topbar_btn_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 12px 24px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-banner__topbar-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.08);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .custom-banner__topbar-btn:hover::after {
    transform: translateX(0);
  }

  .custom-banner__topbar-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .custom-banner__topbar-btn .btn-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .custom-banner__topbar-btn:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* Mobile menu control: hidden on desktop; layout handled in mobile media query */
  .custom-banner__menu-btn {
    display: none;
  }

  .custom-banner__topbar-actions {
    display: contents;
  }

  .custom-banner__topbar-spacer {
    display: none;
  }

  /* Breadcrumb + “Choose a Gift” under top bar */
  .custom-banner__subnav {
    padding: 10px 32px 14px;
    margin: 0;
    border-bottom: 1px solid #e0e0e0;
    background: {{ section.settings.background_color }};
    position: relative;
    z-index: 10;
  }

  .custom-banner__breadcrumb {
    margin: 0;
  }

  .custom-banner__breadcrumb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 12px;
    line-height: 1.4;
    color: #666666;
  }

  .custom-banner__breadcrumb-list a {
    color: #111111;
    text-decoration: none;
  }

  .custom-banner__breadcrumb-list a:hover {
    text-decoration: underline;
  }

  .custom-banner__breadcrumb-sep {
    color: #999999;
    user-select: none;
  }

  .custom-banner__breadcrumb-current {
    color: #555555;
  }

  .custom-banner__gift-under-bc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 20px;
    background: {{ section.settings.topbar_btn_bg }};
    color: {{ section.settings.topbar_btn_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-banner__gift-under-bc:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .custom-banner__gift-under-bc .btn-arrow {
    display: inline-block;
  }

  /* Injected into theme mobile menu drawer (see script) */
  .menu-drawer .custom-banner__drawer-gift-wrap {
    flex-shrink: 0;
    padding: 16px 20px 28px;
    margin-top: auto;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .menu-drawer .custom-banner__drawer-gift {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .menu-drawer .custom-banner__drawer-gift:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  /* ── HERO: FULL WIDTH IMAGE WITH OVERLAY TEXT ── */
  .custom-banner__hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.banner_height }}px;
    overflow: hidden;
    margin: 0;
  }

  /* Full-width background image */
  .custom-banner__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .custom-banner__hero-placeholder {
    position: absolute;
    inset: 0;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  /* Mobile-only hero split (hidden on desktop — desktop layout unchanged) */
  .custom-banner__hero-image--desktop {
    display: block;
  }

  .custom-banner__hero-image--mobile {
    display: none;
  }

  .custom-banner__hero-mobile-visual {
    display: none;
  }

  .custom-banner__overlay--desktop {
    display: block;
  }

  .custom-banner__overlay--mobile {
    display: none;
  }

  .custom-banner__cta--mobile {
    display: none;
  }

  .custom-banner__cta--desktop {
    display: inline-flex;
  }

  .custom-banner__content-text {
    display: contents;
  }

  /* Optional overlay for text readability */
  .custom-banner__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  /* Text content — bottom left */
  .custom-banner__content {
    position: absolute;
    bottom: 48px;
    left: 48px;
    z-index: 2;
    max-width: 480px;
  }

  .custom-banner__heading {
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 900;
    line-height: 1.05;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    letter-spacing: -1px;
  }

  .custom-banner__subtext {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.subtext_color }};
    margin: 0 0 32px;
  }

  /* SHOP NOW button */
  .custom-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 15px 32px;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    width: fit-content;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-banner__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.cta_color }};
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 0;
  }

  .custom-banner__cta:hover::before {
    transform: scaleX(1);
  }

  .custom-banner__cta:hover {
    color: {{ section.settings.cta_bg }};
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }

  .custom-banner__cta span {
    position: relative;
    z-index: 1;
  }

  .custom-banner__cta .btn-arrow {
    display: inline-block;
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .custom-banner__cta:hover .btn-arrow {
    transform: translateX(6px);
  }

  /* ── STATIC ANNOUNCEMENT STRIP (below hero) ── */
  .custom-banner__announcement-strip {
    width: 100%;
    margin: 0;
    padding: 12px 20px;
    box-sizing: border-box;
    background: {{ section.settings.announcement_bar_bg }};
    color: {{ section.settings.announcement_bar_color }};
    text-align: center;
  }

  .custom-banner__announcement-strip-text {
    margin: 0;
    max-width: 100%;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  /* ── RESPONSIVE (mobile only — desktop base styles unchanged above) ── */
  @media (max-width: 768px) {
    .custom-banner__topbar {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: 0;
      width: 100%;
      box-sizing: border-box;
      min-height: 52px;
      height: auto;
      padding: 0 14px;
      margin: 0;
      position: relative;
      z-index: 10;
      border-bottom: 1px solid #eeeeee;
      background: {{ section.settings.background_color }};
    }

    .custom-banner__menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: auto;
      min-width: 44px;
      min-height: 44px;
      margin: 0;
      padding: 10px;
      border: none;
      border-radius: 0;
      background: transparent;
      color: {{ section.settings.logo_color }};
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      position: relative;
      z-index: 2;
    }

    .custom-banner__menu-btn svg {
      display: block;
      width: 22px;
      height: 22px;
    }

    .custom-banner__announcement {
      display: none;
    }

    .custom-banner__logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      max-width: min(58vw, 240px);
      margin: 0;
      padding: 0 8px;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 1px;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }

    /* Gift CTA lives in mobile menu drawer only — keep layout balance */
    .custom-banner__topbar-actions {
      display: none;
    }

    .custom-banner__topbar-spacer {
      display: block;
      flex: 0 0 auto;
      width: 44px;
      min-width: 44px;
      min-height: 44px;
      position: relative;
      z-index: 2;
    }

    .custom-banner {
      margin-bottom: 0;
    }

    /* Hero: 20% text (top) / 80% image + button (bottom); separate mobile image optional */
    .custom-banner__hero {
      display: flex;
      flex-direction: column;
      min-height: 520px;
      padding: 0;
      box-sizing: border-box;
      margin: 0;
    }

    .custom-banner__hero-placeholder--desktop {
      display: none;
    }

    .custom-banner__hero-image--desktop {
      display: none;
    }

    .custom-banner__hero-image--mobile {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: brightness(0.93);
    }

    .custom-banner__hero-mobile-visual {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      flex: 0 0 80%;
      min-height: 0;
      position: relative;
      overflow: hidden;
    }

    .custom-banner__hero-mobile-visual .custom-banner__hero-placeholder {
      position: absolute;
      inset: 0;
    }

    .custom-banner__overlay--desktop {
      display: none;
    }

    .custom-banner__overlay--mobile {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .custom-banner__cta--desktop {
      display: none;
    }

    .custom-banner__cta--mobile {
      display: inline-flex;
      position: absolute;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%);
      z-index: 3;
      margin: 0;
      padding: 12px 22px;
      align-self: center;
    }

    .custom-banner__content {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
      transform: none;
      flex: 0 0 20%;
      min-height: 0;
      max-width: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 16px 20px;
      box-sizing: border-box;
      z-index: 2;
      background: {{ section.settings.background_color }};
    }

    .custom-banner__content-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .custom-banner__heading {
      font-size: clamp(22px, 5.5vw, 28px);
      font-weight: 900;
      line-height: 1.12;
      margin: 0 0 8px;
      letter-spacing: -0.5px;
    }

    .custom-banner__subtext {
      font-size: 14px;
      line-height: 1.45;
      color: #555555;
      margin: 0;
      max-width: 92%;
      margin-left: auto;
      margin-right: auto;
    }

    .custom-banner__announcement-strip {
      padding: 8px 16px;
      margin-top: 0;
    }

    .custom-banner__announcement-strip-text {
      font-size: 12px;
      letter-spacing: 0.5px;
    }

    .custom-banner__subnav {
      padding: 10px 14px 12px;
    }

    .custom-banner__gift-under-bc {
      margin-top: 10px;
      padding: 9px 16px;
      font-size: 11px;
    }
  }
</style>

<section
  class="custom-banner"
  id="custom-banner-{{ section.id }}"
  data-gift-url="{{ section.settings.topbar_btn_link }}"
  data-gift-label="{{ section.settings.topbar_btn_label | escape }}"
  data-gift-bg="{{ section.settings.topbar_btn_bg }}"
  data-gift-fg="{{ section.settings.topbar_btn_color }}"
>

  <!-- TOP BAR -->
  <div class="custom-banner__topbar">
    <button
      type="button"
      class="custom-banner__menu-btn"
      aria-label="{{ 'accessibility.menu' | t }}"
      aria-controls="Details-menu-drawer-container"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>

    <a href="{{ section.settings.logo_link }}" class="custom-banner__logo">
      {{ section.settings.logo_text }}
    </a>

    <p class="custom-banner__announcement">
      {{ section.settings.topbar_announcement_text }}
    </p>

    <div class="custom-banner__topbar-actions">
      <a href="{{ section.settings.topbar_btn_link }}" class="custom-banner__topbar-btn">
        <span>{{ section.settings.topbar_btn_label }}</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
    <span class="custom-banner__topbar-spacer" aria-hidden="true"></span>
  </div>

  {%- liquid
    assign gift_link = section.settings.below_breadcrumb_gift_link
    if gift_link == blank
      assign gift_link = section.settings.topbar_btn_link
    endif
    assign show_bc = section.settings.show_breadcrumb_under_topbar
    assign has_crumbs = false
    if template.name == 'collection' and collection
      assign has_crumbs = true
    elsif template.name == 'product' and product
      assign has_crumbs = true
    elsif template.name == 'page' and page
      assign has_crumbs = true
    elsif template.name == 'article' and article
      assign has_crumbs = true
    elsif template.name == 'blog' and blog
      assign has_crumbs = true
    endif
    assign show_subnav_row = false
    if gift_link != blank
      assign show_subnav_row = true
    endif
    if show_bc and has_crumbs
      assign show_subnav_row = true
    endif
  -%}
  {% if show_subnav_row %}
    <div class="custom-banner__subnav">
      {% if show_bc and has_crumbs %}
        <nav class="custom-banner__breadcrumb" aria-label="Breadcrumb">
          <ol class="custom-banner__breadcrumb-list">
            <li>
              <a href="{{ routes.root_url }}">Home</a>
            </li>
            {% if template.name == 'collection' and collection %}
              <li>
                <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                <span class="custom-banner__breadcrumb-current">{{ collection.title }}</span>
              </li>
            {% elsif template.name == 'product' and product %}
              {% if product.collections.first %}
                <li>
                  <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                  <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
                </li>
              {% endif %}
              <li>
                <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                <span class="custom-banner__breadcrumb-current">{{ product.title }}</span>
              </li>
            {% elsif template.name == 'page' and page %}
              <li>
                <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                <span class="custom-banner__breadcrumb-current">{{ page.title }}</span>
              </li>
            {% elsif template.name == 'article' and article %}
              {% if blog %}
                <li>
                  <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                  <a href="{{ blog.url }}">{{ blog.title }}</a>
                </li>
              {% endif %}
              <li>
                <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                <span class="custom-banner__breadcrumb-current">{{ article.title }}</span>
              </li>
            {% elsif template.name == 'blog' and blog %}
              <li>
                <span class="custom-banner__breadcrumb-sep" aria-hidden="true">/</span>
                <span class="custom-banner__breadcrumb-current">{{ blog.title }}</span>
              </li>
            {% endif %}
          </ol>
        </nav>
      {% endif %}
      {% if gift_link != blank %}
        <a href="{{ gift_link }}" class="custom-banner__gift-under-bc">
          <span>{{ section.settings.below_breadcrumb_gift_label }}</span>
          <span class="btn-arrow">→</span>
        </a>
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    assign hero_desktop = section.settings.hero_image
    assign hero_mobile = section.settings.hero_image_mobile
    if hero_mobile == blank
      assign hero_mobile = hero_desktop
    endif
  -%}
  <!-- HERO: FULL WIDTH IMAGE + OVERLAY TEXT (desktop unchanged; mobile uses 20% / 80% split + optional mobile image) -->
  <div class="custom-banner__hero">

    {% if hero_desktop %}
      <img
        class="custom-banner__hero-image custom-banner__hero-image--desktop"
        src="{{ hero_desktop | image_url: width: 2000 }}"
        alt="{{ hero_desktop.alt | escape }}"
        loading="eager"
        width="2000"
      >
    {% else %}
      <div class="custom-banner__hero-placeholder custom-banner__hero-placeholder--desktop">
        Add a full-width image in the customizer
      </div>
    {% endif %}

    <!-- Optional dark overlay for text readability (desktop full-bleed image) -->
    <div class="custom-banner__overlay custom-banner__overlay--desktop"></div>

    <!-- Text overlay bottom-left (desktop); mobile: text block first (top ~20%), then image + button below -->
    <div class="custom-banner__content">
      <div class="custom-banner__content-text">
        <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
        <p class="custom-banner__subtext">{{ section.settings.subtext }}</p>
      </div>
      <a href="{{ section.settings.cta_link }}" class="custom-banner__cta custom-banner__cta--desktop">
        <span>{{ section.settings.cta_label }}</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>

    <div class="custom-banner__hero-mobile-visual">
      {% if hero_mobile %}
        <img
          class="custom-banner__hero-image custom-banner__hero-image--mobile"
          src="{{ hero_mobile | image_url: width: 1200 }}"
          alt="{{ hero_mobile.alt | escape }}"
          loading="eager"
          width="1200"
        >
      {% else %}
        <div class="custom-banner__hero-placeholder">
          Add a full-width image in the customizer
        </div>
      {% endif %}
      <div class="custom-banner__overlay custom-banner__overlay--mobile"></div>
      <a href="{{ section.settings.cta_link }}" class="custom-banner__cta custom-banner__cta--mobile">
        <span>{{ section.settings.cta_label }}</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>

  </div>

  <!-- STATIC ANNOUNCEMENT BAR -->
  <div class="custom-banner__announcement-strip">
    <p class="custom-banner__announcement-strip-text">{{ section.settings.announcement_text }}</p>
  </div>

</section>

<script>
  (function () {
    var root = document.getElementById('custom-banner-{{ section.id }}');
    if (!root) return;

    var menuBtn = root.querySelector('.custom-banner__menu-btn');
    if (menuBtn) {
      menuBtn.addEventListener('click', function () {
        var summary = document.querySelector('#Details-menu-drawer-container summary');
        if (summary) {
          summary.click();
        } else {
          window.location.assign('{{ routes.all_products_collection_url }}');
        }
      });
    }

    function isMobileLayout() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function injectGiftIntoDrawer() {
      if (!isMobileLayout()) return;
      var url = (root.dataset.giftUrl || '').trim();
      if (!url) return;

      var details = document.querySelector('#Details-menu-drawer-container');
      var drawer = details && details.querySelector('.menu-drawer');
      if (!drawer || drawer.querySelector('.custom-banner__drawer-gift-wrap')) return;

      var wrap = document.createElement('div');
      wrap.className = 'custom-banner__drawer-gift-wrap';

      var a = document.createElement('a');
      a.className = 'custom-banner__drawer-gift';
      a.href = url;
      a.style.background = root.dataset.giftBg || '';
      a.style.color = root.dataset.giftFg || '';

      var span = document.createElement('span');
      span.textContent = root.dataset.giftLabel || '';
      a.appendChild(span);

      var arrow = document.createElement('span');
      arrow.className = 'btn-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      a.appendChild(arrow);

      wrap.appendChild(a);
      drawer.appendChild(wrap);
    }

    var detailsEl = document.querySelector('#Details-menu-drawer-container');
    if (detailsEl) {
      detailsEl.addEventListener('toggle', function () {
        if (detailsEl.open) {
          requestAnimationFrame(injectGiftIntoDrawer);
        }
      });
    }
  })();
</script>

