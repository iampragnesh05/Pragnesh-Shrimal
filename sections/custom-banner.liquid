{% comment %} Custom Banner Section {% endcomment %}

<style>
  .custom-banner {
    position: relative;
    width: 100%;
    font-family: sans-serif;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  /* ── TOP NAV BAR ── */
  .custom-banner__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    border-bottom: 1px solid #e0e0e0;
    position: relative;
    z-index: 10;
    background: {{ section.settings.background_color }};
  }

  .custom-banner__logo {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.logo_color }};
    text-decoration: none;
  }

  .custom-banner__announcement {
    font-size: 14px;
    color: {{ section.settings.announcement_color }};
    letter-spacing: 0.5px;
  }

  .custom-banner__topbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: {{ section.settings.topbar_btn_bg }};
    color: {{ section.settings.topbar_btn_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 12px 24px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-banner__topbar-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.08);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .custom-banner__topbar-btn:hover::after {
    transform: translateX(0);
  }

  .custom-banner__topbar-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .custom-banner__topbar-btn .btn-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .custom-banner__topbar-btn:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* ── HERO: FULL WIDTH IMAGE WITH OVERLAY TEXT ── */
  .custom-banner__hero {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.banner_height }}px;
    overflow: hidden;
    margin: 0;
  }

  /* Full-width background image */
  .custom-banner__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .custom-banner__hero-placeholder {
    position: absolute;
    inset: 0;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  /* Optional overlay for text readability */
  .custom-banner__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  /* Text content — bottom left */
  .custom-banner__content {
    position: absolute;
    bottom: 48px;
    left: 48px;
    z-index: 2;
    max-width: 480px;
  }

  .custom-banner__heading {
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 900;
    line-height: 1.05;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    letter-spacing: -1px;
  }

  .custom-banner__subtext {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.subtext_color }};
    margin: 0 0 32px;
  }

  /* SHOP NOW button */
  .custom-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 15px 32px;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    width: fit-content;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-banner__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.cta_color }};
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 0;
  }

  .custom-banner__cta:hover::before {
    transform: scaleX(1);
  }

  .custom-banner__cta:hover {
    color: {{ section.settings.cta_bg }};
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }

  .custom-banner__cta span {
    position: relative;
    z-index: 1;
  }

  .custom-banner__cta .btn-arrow {
    display: inline-block;
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .custom-banner__cta:hover .btn-arrow {
    transform: translateX(6px);
  }

  /* ── STATIC ANNOUNCEMENT STRIP (below hero) ── */
  .custom-banner__announcement-strip {
    width: 100%;
    margin: 0;
    padding: 12px 20px;
    box-sizing: border-box;
    background: {{ section.settings.announcement_bar_bg }};
    color: {{ section.settings.announcement_bar_color }};
    text-align: center;
  }

  .custom-banner__announcement-strip-text {
    margin: 0;
    max-width: 100%;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .custom-banner__topbar {
      flex-wrap: wrap;
      gap: 12px;
      padding: 12px 20px;
    }

    .custom-banner__announcement {
      order: 3;
      width: 100%;
      text-align: center;
    }

    .custom-banner__hero {
      min-height: 420px;
    }

    .custom-banner__content {
      bottom: 32px;
      left: 24px;
      right: 24px;
      max-width: 100%;
    }

    .custom-banner__heading {
      font-size: 32px;
    }

    .custom-banner__announcement-strip {
      padding: 8px 16px;
    }

    .custom-banner__announcement-strip-text {
      font-size: 12px;
      letter-spacing: 0.5px;
    }
  }
</style>

<section class="custom-banner" id="custom-banner-{{ section.id }}">

  <!-- TOP BAR -->
  <div class="custom-banner__topbar">
    <a href="{{ section.settings.logo_link }}" class="custom-banner__logo">
      {{ section.settings.logo_text }}
    </a>

    <p class="custom-banner__announcement">
      {{ section.settings.topbar_announcement_text }}
    </p>

    <a href="{{ section.settings.topbar_btn_link }}" class="custom-banner__topbar-btn">
      <span>{{ section.settings.topbar_btn_label }}</span>
      <span class="btn-arrow">→</span>
    </a>
  </div>

  <!-- HERO: FULL WIDTH IMAGE + OVERLAY TEXT -->
  <div class="custom-banner__hero">

    {% if section.settings.hero_image %}
      <img
        class="custom-banner__hero-image"
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager"
        width="2000"
      >
    {% else %}
      <div class="custom-banner__hero-placeholder">
        Add a full-width image in the customizer
      </div>
    {% endif %}

    <!-- Optional dark overlay for text readability -->
    <div class="custom-banner__overlay"></div>

    <!-- Text overlay bottom-left -->
    <div class="custom-banner__content">
      <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
      <p class="custom-banner__subtext">{{ section.settings.subtext }}</p>
      <a href="{{ section.settings.cta_link }}" class="custom-banner__cta">
        <span>{{ section.settings.cta_label }}</span>
        <span class="btn-arrow">→</span>
      </a>
    </div>

  </div>

  <!-- STATIC ANNOUNCEMENT BAR -->
  <div class="custom-banner__announcement-strip">
    <p class="custom-banner__announcement-strip-text">{{ section.settings.announcement_text }}</p>
  </div>

</section>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "settings": [

    {
      "type": "header",
      "content": "🎨 Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "🔠 Logo / Brand"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo Link"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Text Color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "📢 Top bar announcement"
    },
    {
      "type": "text",
      "id": "topbar_announcement_text",
      "label": "Top Bar Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "color",
      "id": "announcement_color",
      "label": "Announcement Text Color",
      "default": "#333333"
    },

    {
      "type": "header",
      "content": "🟡 Top Bar Button"
    },
    {
      "type": "text",
      "id": "topbar_btn_label",
      "label": "Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "topbar_btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "topbar_btn_bg",
      "label": "Button Background",
      "default": "#f0d84a"
    },
    {
      "type": "color",
      "id": "topbar_btn_color",
      "label": "Button Text Color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "🖼️ Hero Banner Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Full-Width Banner Image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner Height (px)",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color (for text readability)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 70,
      "step": 5,
      "default": 0
    },

    {
      "type": "header",
      "content": "✏️ Hero Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext / Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#333333"
    },

    {
      "type": "header",
      "content": "⬛ Shop Now Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "📢 Announcement Bar (below hero)"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
      "id": "announcement_bar_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "announcement_bar_color",
      "label": "Text color",
      "default": "#333333"
    }

  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
